{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ottawa-transit-watch",
  "compatibility_date": "2026-08-26",
  "main": "./worker/index.js",

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ottawa-transit-watch-db",
      "database_id": "091f5c1f-dffa-4a87-b109-d47f2a6db75f"
    }
  ]
}